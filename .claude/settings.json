{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"allow": [
			"Bash(npm run lint)",
			"Bash(npm run type-check)",
			"PowerShell(npm run lint)",
			"PowerShell(npm run type-check)"
		],
		"ask": [
			"Bash(*api/schedule/book*)",
			"PowerShell(*api/schedule/book*)"
		],
		"deny": [
			"Read(.env*)",
			"Read(!.env.example)"
		]
	},
	"enabledMcpjsonServers": ["next-devtools", "motion", "zod"]
}
